# ==============================================================================
# Configuración de Conexión a Base de Datos MySQL / MariaDB
# ==============================================================================

# Configuración por defecto (XAMPP / MySQL Local):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_poo

# Alternativa: Si ejecutas MySQL mediante Docker (`docker compose up -d`):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=tienda_user
# DB_PASSWORD=tienda_password
# DB_NAME=tienda_poo
